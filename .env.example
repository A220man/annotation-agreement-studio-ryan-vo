# Application environment
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
DEMO_MODE=true

# Database storage (SQLite file path or in-memory)
DATABASE_URL=sqlite:///./data/annotation_studio.db

# Authentication / OIDC Keycloak settings
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/annotation-realm
OIDC_AUDIENCE=annotation-agreement-studio
OIDC_CLIENT_ID=annotation-agreement-studio-client
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=http://127.0.0.1:8080/realms/annotation-realm/.well-known/openid-configuration

# Advisory LLM settings (strictly opt-in, non-secret defaults)
# Supported providers: openai-compatible, anthropic, gemini, ollama
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=15
